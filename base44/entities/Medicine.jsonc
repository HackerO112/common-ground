{
  "name": "Medicine",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "person_name": {
      "type": "string"
    },
    "dosage": {
      "type": "string"
    },
    "form": {
      "type": "string",
      "enum": [
        "tablet",
        "capsule",
        "liquid",
        "injection",
        "inhaler",
        "other"
      ],
      "default": "tablet"
    },
    "times": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "instructions": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "dosage",
    "times"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}