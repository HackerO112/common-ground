{
  "name": "TuitionPost",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "offer",
        "request"
      ],
      "default": "offer"
    },
    "subject": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "primary",
        "middle",
        "secondary",
        "senior",
        "competitive"
      ]
    },
    "area": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "in_person",
        "online",
        "either"
      ],
      "default": "in_person"
    },
    "schedule": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "contact": {
      "type": "string"
    },
    "posted_by_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "matched",
        "closed"
      ],
      "default": "open"
    }
  },
  "required": [
    "kind",
    "subject",
    "level",
    "area",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}