{
  "name": "BloodRequest",
  "type": "object",
  "properties": {
    "patient_name": {
      "type": "string"
    },
    "blood_group": {
      "type": "string",
      "enum": [
        "A+",
        "A-",
        "B+",
        "B-",
        "AB+",
        "AB-",
        "O+",
        "O-"
      ]
    },
    "units": {
      "type": "number",
      "default": 1
    },
    "hospital": {
      "type": "string"
    },
    "area": {
      "type": "string"
    },
    "needed_by": {
      "type": "string"
    },
    "contact": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "requested_by_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "fulfilled",
        "cancelled"
      ],
      "default": "open"
    }
  },
  "required": [
    "blood_group",
    "hospital",
    "area",
    "contact",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}